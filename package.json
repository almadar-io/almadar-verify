{
  "name": "@almadar-io/verify",
  "version": "3.0.5",
  "description": "Shared Playwright verification utilities for Almadar runtime and compiled projects",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@almadar/core": ">=5.9.0",
    "@almadar/patterns": ">=2.18.2",
    "@faker-js/faker": "^9.9.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": ">=2.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "10.0.0",
    "playwright": "1.50.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-verify.git"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "verify",
    "playwright",
    "testing"
  ],
  "homepage": "https://github.com/almadar-io/almadar-verify#readme"
}
